# ==============================================================================
# BRIGHTLOOP SUBSCRIPTION MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Port and Environment
PORT=5000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 1. DATABASE SELECTOR (Choose either: 'supabase' OR 'mysql')
# ------------------------------------------------------------------------------
DATABASE_TYPE=mysql

# ------------------------------------------------------------------------------
# 2. LOCAL MYSQL CONFIGURATION (Used when DATABASE_TYPE=mysql)
# ------------------------------------------------------------------------------
MYSQL_DB_HOST=127.0.0.1
MYSQL_DB_PORT=3306
MYSQL_DB_NAME=brightloop_db
MYSQL_DB_USER=root
MYSQL_DB_PASSWORD=password

# ------------------------------------------------------------------------------
# 3. SUPABASE POSTGRESQL CONFIGURATION (Used when DATABASE_TYPE=supabase)
# ------------------------------------------------------------------------------
# In Supabase Dashboard -> Settings -> Database -> Connection string:
SUPABASE_DB_HOST=aws-0-ap-south-1.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.your_project_ref
SUPABASE_DB_PASSWORD=your_supabase_password
SUPABASE_DB_SSL=true

# Supabase Auth API (Optional if using Supabase Auth)
SUPABASE_URL=https://your_project_ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ------------------------------------------------------------------------------
# 4. JWT AUTHENTICATION (Used for Local Auth and Session Verification)
# ------------------------------------------------------------------------------
JWT_SECRET=super_secret_brightloop_jwt_key_change_in_production_987654321
JWT_EXPIRES_IN=7d
